{
  "name": "cdkgithub",
  "version": "0.1.0",
  "description": "Define GitHub organization structure (teams, hierarchy, Entra ID/SCIM links) as Infrastructure-as-Code, built on the constructs programming model (inspired by AWS CDK).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FactbirdHQ/cdkgithub.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*.js": "./src/*.ts"
  },
  "bin": {
    "cdkgithub": "src/bin/cdkgithub.ts"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc --noEmit && tsc --noEmit -p test/vocabulary/tsconfig.json",
    "test": "bun test",
    "synth": "bun src/bin/cdkgithub.ts synth examples/factbird.ts",
    "diff": "bun src/bin/cdkgithub.ts diff",
    "plan": "bun src/bin/cdkgithub.ts plan",
    "apply": "bun src/bin/cdkgithub.ts apply",
    "synth:workflows": "bun cicd/main.ts",
    "compile": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/rest": "^22.0.1",
    "bottleneck": "^2.19.5",
    "constructs": "^10.4.2",
    "ink": "^8.0.0",
    "libsodium-wrappers": "^0.8.4",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@factbird/cdkactions": "^2.1.2",
    "@tsconfig/bun": "^1.0.11",
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/node22": "^22.0.6",
    "@types/bun": "^1.2.0",
    "@types/libsodium-wrappers": "^0.8.2",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
