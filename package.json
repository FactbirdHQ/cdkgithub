{
  "name": "cdkgithub",
  "version": "0.1.0",
  "description": "Define GitHub organization structure (teams, hierarchy, Entra ID/SCIM links) as Infrastructure-as-Code, built on the constructs programming model (inspired by AWS CDK).",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "cdkgithub": "bin/cdkgithub.ts"
  },
  "scripts": {
    "build": "tsc --noEmit && tsc --noEmit -p test/vocabulary/tsconfig.json",
    "test": "bun test",
    "synth": "bun bin/cdkgithub.ts synth examples/factbird.ts",
    "diff": "bun bin/cdkgithub.ts diff",
    "plan": "bun bin/cdkgithub.ts plan",
    "apply": "bun bin/cdkgithub.ts apply",
    "synth:workflows": "bun cicd/main.ts"
  },
  "dependencies": {
    "@factbird/cdkactions": "^2.1.2",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/rest": "^21.1.1",
    "constructs": "^10.4.2",
    "libsodium-wrappers": "^0.8.4"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/libsodium-wrappers": "^0.8.2",
    "typescript": "^5.7.0"
  }
}
